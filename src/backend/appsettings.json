{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ReactCoreDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=ReactCoreApp"
  },
  "Jwt": {
    "Key": "super_secret_key_must_be_at_least_32_chars_long",
    "Issuer": "ReactCoreBackend",
    "Audience": "ReactCoreFrontend"
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:5173"
  },
  "RateLimiting": {
    "Admin": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
